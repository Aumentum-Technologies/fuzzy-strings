<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AT.DuoVia.FuzzyStrings</id>
    <version>.*</version>
    <authors>Tyler Jensen</authors>
    <owners>Tyler Jensen</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>A Collection of Fuzzy String Algorithms for .NET. Partially derived from multiple open sources. See individual algorithm classes for attributions.</description>
    <copyright>Tyler Jensen</copyright>
    <tags>Fuzzy Strings Dice Coefficient Levenshtein LCS DoubleMetaphone</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2" />
    </dependencies>
  </metadata>
  <files>
    <file src="lib\net462\**\*.*" target="lib\net462" />
    <file src="Tools\**\*.*" target="Tools" />
  </files>
</package>